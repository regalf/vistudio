{
  "name": "vistudio",
  "version": "1.1.0",
  "description": "A lightweight, extensible code editor built with Electron, React, TypeScript, and Monaco Editor",
  "main": "dist-electron/main.js",
  "author": {
    "name": "regalf",
    "email": "maintainer.regalf@gmail.com",
    "url": "https://github.com/regalf"
  },
  "license": "GPL-3.0-only",
  "keywords": [
    "editor",
    "ide",
    "electron",
    "monaco-editor",
    "react",
    "typescript",
    "code-editor",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/regalf/vistudio.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "./run.sh",
    "start": "./run.sh",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:linux": "npm run build && electron-builder --linux deb rpm AppImage tar.gz",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:rpm": "npm run build && electron-builder --linux rpm",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:win": "npm run build && electron-builder --win portable nsis",
    "dist:nsis": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.regalf.vistudio",
    "productName": "ViStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "extensions/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "icon": "public/icons/logo-512.png",
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "regalf",
      "repo": "vistudio",
      "private": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz",
        "flatpak"
      ],
      "category": "Development",
      "desktop": {
        "entry": {
          "Name": "ViStudio",
          "Comment": "A modern, extensible code editor",
          "Categories": "Development;IDE;"
        }
      }
    },
    "flatpak": {
      "appId": "com.regalf.vistudio",
      "branch": "stable",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "23.08",
      "sdk": "org.freedesktop.Sdk",
      "useWayland": true
    },
    "deb": {
      "depends": ["libc6", "libgl1-mesa-glx", "libxss1", "libnss3"]
    },
    "rpm": {
      "depends": ["glibc", "mesa-libGL", "libXScrnSaver", "nss"]
    },
    "win": {
      "target": [
        "portable",
        "nsis",
        "dir"
      ],
      "icon": "public/icons/logo.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icons/logo.ico",
      "uninstallerIcon": "public/icons/logo.ico",
      "installerHeaderIcon": "public/icons/logo.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ViStudio"
    },
    "mac": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "electron-updater": "^6.8.3",
    "monaco-editor": "^0.45.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.1",
    "wait-on": "^7.2.0"
  }
}
