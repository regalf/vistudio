{
  "name": "vistudio",
  "version": "0.9.0",
  "description": "A lightweight, extensible code editor built with Electron, React, TypeScript, and Monaco Editor",
  "main": "dist-electron/main.js",
  "author": {
    "name": "regalf",
    "url": "https://github.com/regalf"
  },
  "license": "GPL-3.0-only",
  "keywords": [
    "editor",
    "ide",
    "electron",
    "monaco-editor",
    "react",
    "typescript",
    "code-editor",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/regalf/vistudio.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "./run.sh",
    "start": "./run.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "monaco-editor": "^0.45.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.1",
    "wait-on": "^7.2.0"
  }
