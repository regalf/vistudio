{
  "name": "sample-extension",
  "version": "1.0.0",
  "description": "Sample extension for ViStudio",
  "author": "ViStudio Team",
  "main": "extension.js",
  "activationEvents": ["*"],
  "contributes": {
    "commands": [
      {
        "command": "sample.helloWorld",
        "title": "Hello World",
        "category": "Sample"
      }
    ],
    "languages": [
      {
        "id": "samplelang",
        "extensions": [".sample"],
        "aliases": ["Sample Language"]
      }
    ]
  }
}
